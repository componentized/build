package componentized:build-hello;

// wasmtime does not provide wasi:logging, the composition does, writing to stderr
let logging = new local:dep-componentized-logging-to-stderr { ... };

let defaults = new local:defaults {};

let greeter = new local:greeter {
    "wasi:logging/logging@0.1.0-draft": logging["wasi:logging/logging@0.1.0-draft"],
    "componentized:build/defaults@0.1.0": defaults["componentized:build/defaults@0.1.0"],
};

export greeter["componentized:build/greeter@0.1.0"];
